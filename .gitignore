# ============================================================
# Knight —— Godot 客户端 + Go 服务端 + Protobuf
# ============================================================

# ===== 通用 =====
.DS_Store
Thumbs.db
Desktop.ini
*.log

# IDE（Rider / VS / VSCode 的本地缓存）
.idea/
*.iml
.vs/
.vscode/

# ===== Godot 客户端 (Knight-Client) =====
# Godot 自动生成的缓存、临时与构建目录（含 .NET 中间产物）
Knight-Client/.godot/
Knight-Client.Tests/[Bb]in/
Knight-Client.Tests/[Oo]bj/
Knight-Client.Tests/.godot/

# Godot 导出产物
Knight-Client/.exports/
Knight-Client/*.exe

# ===== 设计数据 (Knight-Design) =====
# Excel 打开源表时的临时锁文件
Knight-Design/Datas/~$*.xlsx

# C# 本地运行日志与临时文件
Knight-Client/*.tmp
Knight-Client/*.user
Knight-Client/*.suo

# ===== Go 服务端 (Knight-Server) =====
# 编译产物
Knight-Server/bin/
Knight-Server/*.exe
Knight-Server/*.exe~

# 测试二进制、覆盖率与性能分析产物
Knight-Server/*.test
Knight-Server/*.out
Knight-Server/*.prof

# Go workspace 文件（多模块开发时再按需提交）
Knight-Server/go.work
Knight-Server/go.work.sum

# 本地运行日志
Knight-Server/logs/

# 依赖目录：如团队决定提交 vendor/，删除下面这行
# Knight-Server/vendor/

# ===== Protobuf 生成产物 =====
# 产物由 Knight-Tools/gen-proto.ps1 全量重生成、可复现，默认两端都提交：
#   Knight-Client/Scripts/Base/Gen/Proto/Knight.cs
#   Knight-Server/protogen/knight.pb.go
# 如改为"不提交、各端自行生成"，取消下面两行注释：
# Knight-Client/Scripts/Base/Gen/Proto/
# Knight-Server/protogen/
/.zcode
/.scratch
